# Copiez ce fichier en .env puis renseignez votre clé API Anthropic
# (à créer sur https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-...

# Facultatif
ANTHROPIC_MODEL=claude-sonnet-5-5
PORT=3000
# MOCK=1   active un mode démo sans clé (réponses fictives) pour tester la mise en page
