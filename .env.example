# Copiez ce fichier en .env puis renseignez votre clé API Anthropic
# (à créer sur https://console.anthropic.com/settings/keys)
# La clé reste sur le serveur : elle n'est jamais envoyée au navigateur.
ANTHROPIC_API_KEY=sk-ant-...

# Mot de passe d'accès à l'atelier (interface + API).
# Obligatoire dès que le serveur écoute sur le réseau (Docker, HOST=0.0.0.0).
# Choisissez une phrase longue, par exemple 4 ou 5 mots au hasard.
APP_PASSWORD=

# Facultatif
ANTHROPIC_MODEL=claude-sonnet-5-5
PORT=3000
# SESSION_HOURS=12    durée d'une connexion
# JOBS_PER_HOUR=30    générations lancées par heure et par adresse IP
# HTTPS=1             site servi en HTTPS (cookie Secure + en-tête HSTS)
# TRUST_PROXY=1       derrière un proxy inverse (nginx, Caddy…) : lit X-Forwarded-For
# MOCK=1              mode démo sans clé (réponses fictives) pour tester la mise en page
